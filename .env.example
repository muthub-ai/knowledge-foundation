# Copy to .env on your Mac (never commit .env). Read by llmwiki2 and tools/librarian/ingest.py.

# Claude writes (Anthropic's OpenAI-compatible endpoint)
OKF_LLM_PROVIDER=custom
OKF_LLM_BASE_URL=https://api.anthropic.com/v1/
OKF_LLM_MODEL=claude-sonnet-5-5
OKF_LLM_API_KEY=sk-ant-...            # your Anthropic API key

# A local classifier decides (Ollama 0.35+ serving /systemone; see docs/local-classifier.md)
OKF_MODE=crow
OKF_CLASSIFIER_PROVIDER=custom
OKF_CLASSIFIER_BASE_URL=http://localhost:11434/v1
OKF_CLASSIFIER_MODEL=tev1-8k
OKF_CLASSIFIER_TIMEOUT=8

# House style and the bundle
OKF_PROMPTS_DIR=prompts
OKF_BUNDLE=wiki
OKF_MAX_DEPTH=3
OKF_USAGE_LOG=.usage.jsonl
